{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identitymicroservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ]
    },
    {
        "DownstreamPathTemplate": "/api/music/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
            {
                "Host": "musicmicroservice",
                "Port": 8080
            }
        ],
        "UpstreamPathTemplate": "/music/{everything}",
        "UpstreamHttpMethod": [ "Get", "Post", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/playlist/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "musicmicroservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/playlist/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/favorites/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "favoritesservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/favorites/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete", "Put" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:7000"
  }
}